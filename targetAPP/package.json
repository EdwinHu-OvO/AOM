{
  "name": "targetapp-food-delivery-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A generic cross-platform Electron food delivery demo with a separated mock backend.",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev:api": "tsc -p tsconfig.node.json && node dist/server/dev.js",
    "dev": "tsc -p tsconfig.node.json && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.node.json && vite build",
    "preview": "pnpm build && electron .",
    "test": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "41.1.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
